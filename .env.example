# Local Share environment template.
# This app reads process environment variables; it does not auto-load this file.
# Example: cp .env.example .env, then: set -a; . ./.env; set +a; pnpm start

# Bind address and port.
PORT=3000
HOST=0.0.0.0

# Use a long random value. Generate one with: openssl rand -base64 32
# Leave empty/unset to generate a new random token on every server start.
# ACCESS_TOKEN=

# Explicitly disable authentication. Only for a trusted local network.
AUTH_DISABLED=false

# Public URL used by the QR endpoint (optional, useful behind a reverse proxy).
# PUBLIC_URL=https://share.example.com

# HTTPS/WSS (both are required to enable TLS).
# TLS_KEY=./key.pem
# TLS_CERT=./cert.pem

# Extra allowed browser origins for WebSocket upgrades, comma-separated.
# ALLOWED_ORIGINS=https://share.example.com

# Only enable this behind a trusted reverse proxy.
# TRUST_PROXY=false

# Resource and transfer limits.
MAX_CLIENTS=100
MAX_FILE_SIZE_MB=100
MAX_ACTIVE_TRANSFERS=3
WS_MAX_PAYLOAD_BYTES=65536
WS_MAX_BUFFERED_BYTES=16777216

# Rate limits.
CHAT_RATE_CAPACITY=12
CHAT_RATE_REFILL_PER_SEC=2
FILE_RATE_MBPS=32
FILE_RATE_BURST_MB=4
QR_RATE_LIMIT=30
AUTH_ATTEMPT_LIMIT=30
TRANSFER_IDLE_TIMEOUT_MS=60000

# error, warn, info, or debug.
LOG_LEVEL=info
